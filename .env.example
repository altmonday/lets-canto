# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only — used solely for account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (server only). Without it, lessons use the hand-authored fallback curriculum.
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5
# LESSON_EFFORT=medium            # low | medium | high
# ANTHROPIC_DISABLE_FALLBACKS=1   # turn off server-side refusal fallbacks

# Optional: Hong Kong Cantonese neural TTS (Azure Speech). Without it, the app uses an
# on-device zh-HK voice when the browser has one, and never a Mandarin voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_VOICE=zh-HK-HiuMaanNeural
